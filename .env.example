# ============================================================
# Wolf Host — environment template
# Copy to .env (or set these as Railway service variables)
# ============================================================

# --- Core (required) ---
SECRET_KEY=change-me-to-a-long-random-string

# These are provided automatically on Railway (Postgres / Redis plugins).
# For LOCAL docker-compose they are derived from the POSTGRES_* vars below,
# so you normally do NOT need to set DATABASE_URL / REDIS_URL here.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL=redis://:password@host:6379/0

# Browser-facing origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost

# Where the frontend calls the backend API (build-time for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Local docker-compose only (Postgres / Redis) ---
POSTGRES_USER=wolfhost
POSTGRES_PASSWORD=wolfhost
POSTGRES_DB=wolfhost

# --- Initial admin (used by db seed) ---
ADMIN_EMAIL=admin@wolfhost.local
ADMIN_PASSWORD=ChangeMe123!

# --- Payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
TRONGRID_API_KEY=
BSCSCAN_API_KEY=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wolfhost.local
